<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon background: a full-bleed 108dp vector so the launcher can
    mask/parallax it without ever resampling a bitmap.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item
                    android:color="#FF1C2A22"
                    android:offset="0" />
                <item
                    android:color="#FF141414"
                    android:offset="0.55" />
                <item
                    android:color="#FF0A0A0A"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
